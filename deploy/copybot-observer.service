[Unit]
Description=Copybot — single authoritative observer (local dry-run template)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/copybot/deploy/copybot.env
Environment=PYTHONUNBUFFERED=1
Environment=BOT_DIR=/opt/copybot
Environment=BOT_PORT=8807
# Observers may use a separately scoped operator halt capability, never a
# private trading/signing key.
UnsetEnvironment=PRIVATE_KEY
User=copybot
Group=copybot
WorkingDirectory=/opt/copybot
ExecStart=/usr/bin/python3 /opt/copybot/deploy/observer/main.py
Restart=on-failure
RestartSec=10
# Allow an in-flight serialized audit to finish and fsync its evidence before
# releasing the exclusive owner lock; systemd remains the ultimate stop bound.
TimeoutStopSec=120s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/copybot/run
StandardOutput=append:/opt/copybot/run/observer.log
StandardError=append:/opt/copybot/run/observer.log
CapabilityBoundingSet=
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

# Template only; no service installation, enablement, or restart is part of this local change.
[Install]
WantedBy=multi-user.target
